<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_corpwallet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="40dp"
        android:paddingRight="28dp"
        android:paddingBottom="28dp">

        <!-- Top brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/bg_brand_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="CorpWallet"
                android:textColor="#F5F7FF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical">

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:background="@drawable/bg_orbit_outer" />

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_orbit_middle" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_orbit_inner" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="#61A0FF"
                    android:textSize="28sp"
                    android:background="@drawable/bg_lock_center" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginLeft="20dp"
                    android:background="@drawable/bg_dot_small" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginRight="16dp"
                    android:background="@drawable/bg_dot_big" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/bg_dot_small" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="CorpWallet"
                android:textColor="#F5F7FF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Secure transaction control for enterprise finance"
                android:textColor="#8F9CB8"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂  Enterprise-grade"
                    android:textColor="#7E8FB2"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="|"
                    android:textColor="#31405C"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="◈  Multi-layer security"
                    android:textColor="#7E8FB2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom CTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnEnter"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="Enter Workspace"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary_corp" />

            <TextView
                android:id="@+id/btnLoginTop"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Sign In"
                android:textColor="#E6ECFF"
                android:textSize="18sp"
                android:background="@drawable/bg_button_secondary_corp" />

            <TextView
                android:id="@+id/btnDemoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="Use Demo Access"
                android:textColor="#6D7C99"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
