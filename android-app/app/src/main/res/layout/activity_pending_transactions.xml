<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#05070B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQueueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORPWALLET"
                android:textColor="#7E8AA6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQueueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Expense desk"
                android:textColor="#F4F7FB"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Open an expense to review its request or decision."
                android:textColor="#8B95AA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_primary_card">

            <TextView
                android:id="@+id/tvQueueSummaryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM REVIEW"
                android:textColor="#9BA9C4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvQueueSummaryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Loading expenses…"
                android:textColor="#F4F7FB"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueSummaryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Local workspace · sample expenses"
                android:textColor="#9BA9C4"
                android:textSize="12sp" />
        </LinearLayout>

        <Button android:id="@+id/newExpense" android:text="New sample expense" android:textAllCaps="false"
            android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button android:id="@+id/refresh" android:text="Refresh" android:textAllCaps="false"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/export" android:text="Export evidence" android:textAllCaps="false"
                android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
