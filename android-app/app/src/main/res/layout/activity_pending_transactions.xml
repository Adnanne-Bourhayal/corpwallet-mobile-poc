<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#05070B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQueueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approval Queue"
                android:textColor="#7E8AA6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQueueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pending Transactions"
                android:textColor="#F4F7FB"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Review pending approvals in a trusted corporate workspace"
                android:textColor="#8B95AA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_primary_card">

            <TextView
                android:id="@+id/tvQueueSummaryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Queue Summary"
                android:textColor="#9BA9C4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvQueueSummaryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2 approvals pending"
                android:textColor="#F4F7FB"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueSummaryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="High-trust session required for sensitive approvals"
                android:textColor="#9BA9C4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
