<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLoginBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURE CORPORATE ACCESS"
            android:textColor="#DCE8FF"
            android:textSize="12sp"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_trust_badge" />

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Sign in to CorpWallet"
            android:textColor="#F4F7FB"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Access the protected treasury approval workspace."
            android:textColor="#8B95AA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_login_card">

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Username"
                android:textColor="#F4F7FB"
                android:textColorHint="#7E8AA6"
                android:background="@drawable/bg_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="#F4F7FB"
                android:textColorHint="#7E8AA6"
                android:background="@drawable/bg_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="#FF8A8A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Sign In"
                android:textColor="#F4F7FB"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_action_button" />

            <TextView
                android:id="@+id/btnDemoAccess"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Use Demo Access"
                android:textColor="#D4E0FF"
                android:textSize="14sp"
                android:background="@drawable/bg_action_button_secondary" />

            <TextView
                android:id="@+id/tvLoginHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Demo credentials: admin / admin"
                android:textColor="#6F7D97"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
