<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="15dp" android:paddingBottom="15dp"
    android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tvMonogram" android:layout_width="38dp" android:layout_height="38dp"
        android:gravity="center" android:textSize="13sp" android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no" android:background="@drawable/bg_monogram" android:textColor="@color/ink"/>
    <LinearLayout android:id="@+id/recipientColumn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvRecipient" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
            android:fontFamily="sans-serif-medium" android:textSize="16sp" android:textColor="@color/ink"/>
        <TextView android:id="@+id/tvPurpose" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/muted"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/valueColumn" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp">
        <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="17sp" android:textColor="@color/ink"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/muted"/>
    </LinearLayout>
</LinearLayout>
